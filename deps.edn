{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases
 {;; Start a REPL with `clj -A:dev`. Swaps the official compiler for ClojureStorm,
  ;; so keep its version in step with org.clojure/clojure above.
  :dev {:extra-paths ["dev"]
        :classpath-overrides {org.clojure/clojure nil}
        :extra-deps {com.github.flow-storm/clojure {:mvn/version "1.12.5-1"}
                     com.github.flow-storm/flow-storm-dbg {:mvn/version "4.8.1"}
                     djblue/portal {:mvn/version "0.68.1"}}
        :jvm-opts ["-Dclojure.storm.instrumentEnable=true"
                   "-Dclojure.storm.instrumentAutoPrefixes=false"
                   "-Dclojure.storm.instrumentOnlyPrefixes=com.github.stepbeekio"]}

  ;; nREPL server with CIDER middleware. Combine with :dev: `clojure -M:dev:nrepl`.
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.64.0"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}

  ;; nREPL server with the FlowStorm UI open in the same JVM, so it records what
  ;; you evaluate from your editor. Combine with :dev and :nrepl (for the deps):
  ;; `clojure -M:dev:nrepl:flowstorm`.
  :flowstorm {:main-opts ["-e" "(user/start-flowstorm!)"
                          "-m" "nrepl.cmdline"
                          "--middleware" "[cider.nrepl/cider-middleware]"]}

  ;; Run the tests: `clojure -M:test`.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                            :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; Build tasks from build.clj: `clojure -T:build uber`.
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
